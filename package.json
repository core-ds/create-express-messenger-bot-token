{
  "name": "create-express-messenger-bot-token",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/core-ds/create-express-messenger-bot-token.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts src/post.ts --bundle --outdir=dist --out-extension:.js=.cjs --platform=node --packages=bundle",
    "check-types": "tsc --noEmit",
    "format": "prettier --check \"./**/*.{ts,mjs,json,md,yml}\"",
    "lint": "eslint . --ext .ts,.mjs",
    "release": "yarn build && node scripts/release.ts",
    "version-package": "changeset version"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "is-network-error": "^1.3.2",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
    "@actions/exec": "^3.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "fs-extra": "^11.4.0",
    "globals": "^17.11.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "yarn@4.18.0"
}
